$ python3 after/analyze_text.py --file notes.txt --json | jq -c '{word_count, sentence_count}'
{"word_count":12,"sentence_count":3}
$ python3 after/analyze_text.py --text 'Wait... what? He said "go." Then left.' --json | jq -c '{sentence_count}'
{"sentence_count":4}

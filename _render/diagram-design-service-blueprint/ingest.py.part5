n/service-blueprint/service-blueprint-gallery.png",
            "diagram-design/service-blueprint/service-blueprint-canonical.png",
        ]
    )
    run(
        [
            "git",
            "commit",
            "-m",
            "Add diagram-design Service blueprint walkthrough GIF, MP4, and screenshots",
        ]
    )
    for i in range(1, 6):
        try:
            run(["git", "pull", "--rebase", "origin", "main"])
            run(["git", "push", "origin", "HEAD:main"])
            return
        except subprocess.CalledProcessError:
            subprocess.call(["git", "rebase", "--abort"])
            import time

            time.sleep(i * 3)
    raise SystemExit("push failed")


if __name__ == "__main__":
    main()

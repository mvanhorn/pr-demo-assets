reenshot_export_shape_selectors.png",
            "rea/export-shape-presence/screenshot_export_shape_before.png",
            "rea/export-shape-presence/screenshot_export_shape_after.png",
        ]
    )
    run(
        [
            "git",
            "commit",
            "--author=Matt Van Horn <mvanhorn@users.noreply.github.com>",
            "-m",
            "Add rea export-shape presence walkthrough GIF, MP4, and screenshots",
        ]
    )
    for i in range(1, 6):
        try:
            run(["git", "pull", "--rebase", "origin", "main"])
            run(["git", "push", "origin", "HEAD:main"])
            return
        except subprocess.CalledProcessError:
            subprocess.call(["git", "rebase", "--abort"])
            import time
            time.sleep(i * 3)
    raise SystemExit("push failed")


if __name__ == "__main__":
    main()
